{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Group all Go version updates (go.mod, Dockerfile golang, mise.toml) into a single PR",
      "groupName": "Go version",
      "groupSlug": "go-version",
      "matchPackageNames": ["go", "golang", "golang/go"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    }
  ]
}
